+package io.spring.start.site.extension.internal;
+
+import io.spring.initializr.generator.buildsystem.maven.MavenBuildSystem;
+import io.spring.initializr.generator.condition.ConditionalOnBuildSystem;
+import io.spring.initializr.generator.project.ProjectGenerationConfiguration;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.core.env.Environment;
+
+/**
+ * {@link ProjectGenerationConfiguration} that points the generated Maven wrapper at an
+ * internal repository instead of Maven Central, when
+ * {@code internal.maven-wrapper.repository-url} is set.
+ *
+ * @author Bo
+ */
+@ProjectGenerationConfiguration
+@ConditionalOnBuildSystem(MavenBuildSystem.ID)
+class InternalMavenWrapperProjectGenerationConfiguration {
+
+	static final String REPOSITORY_URL_PROPERTY = "internal.maven-wrapper.repository-url";
+
+	@Bean
+	MavenWrapperRepositoryContributor internalMavenWrapperRepositoryContributor(Environment environment) {
+		return new MavenWrapperRepositoryContributor(environment.getProperty(REPOSITORY_URL_PROPERTY));
+	}
+
+}
diff --git a/start-site/src/main/java/io/spring/start/site/extension/internal/MavenWrapperRepositoryContributor.java b/start-site/src/main/java/io/spring/start/site/extension/internal/MavenWrapperRepositoryContributor.java
