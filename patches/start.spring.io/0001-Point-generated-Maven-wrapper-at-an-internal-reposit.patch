+package io.spring.start.site.extension.internal;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+import io.spring.initializr.generator.project.contributor.ProjectContributor;
+
+import org.springframework.core.Ordered;
+import org.springframework.util.StringUtils;
+
+/**
+ * Rewrites the {@code distributionUrl} of the generated Maven wrapper so that it downloads
+ * Maven from an internal repository. Runs after the wrapper has been written, and keeps
+ * the Maven version the wrapper template chose.
+ *
+ * @author Bo
+ */
+class MavenWrapperRepositoryContributor implements ProjectContributor {
+
+	static final String CENTRAL = "https://repo.maven.apache.org/maven2";
+
+	private static final String WRAPPER_PROPERTIES = ".mvn/wrapper/maven-wrapper.properties";
+
+	private static final String DISTRIBUTION_URL = "distributionUrl=";
+
+	private final String repositoryUrl;
+
+	MavenWrapperRepositoryContributor(String repositoryUrl) {
+		this.repositoryUrl = (repositoryUrl != null) ? StringUtils.trimTrailingCharacter(repositoryUrl, '/') : "";
+	}
+
+	@Override
+	public void contribute(Path projectRoot) throws IOException {
+		if (!StringUtils.hasText(this.repositoryUrl)) {
+			return;
+		}
+		Path properties = projectRoot.resolve(WRAPPER_PROPERTIES);
+		if (!Files.exists(properties)) {
+			return;
+		}
+		List<String> lines = Files.readAllLines(properties, StandardCharsets.ISO_8859_1)
+			.stream()
+			.map(this::rewrite)
+			.toList();
+		Files.write(properties, lines, StandardCharsets.ISO_8859_1);
+	}
+
+	private String rewrite(String line) {
+		if (line.startsWith(DISTRIBUTION_URL)) {
+			return line.replace(CENTRAL, this.repositoryUrl);
+		}
+		return line;
+	}
+
+	@Override
+	public int getOrder() {
+		return Ordered.LOWEST_PRECEDENCE;
+	}
+
+}
